{
  "name": "chicek-frontend-observability",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.0+sha512.266f8957a30d2be6e9468e5e66bcdedd35a794175f71b067ba8504d686cce1d0c0f429b33c323c3c569ad4891e667574a49ff71d1b89a22cc66f13c65818c578",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.x"
  },
  "scripts": {
    "dev": "pnpm --filter @chicek/demo-frontend dev",
    "build": "pnpm --filter @chicek/browser-observability build && node scripts/build/generate-artifact-manifest.js && node scripts/build/verify-build-gate.js && pnpm --filter @chicek/demo-frontend build",
    "test": "pnpm run test:unit && pnpm run test:contract",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:consumer": "vitest run --project consumer",
    "test:security": "vitest run --project security",
    "test:e2e": "playwright test",
    "test:lab": "vitest run --project lab",
    "test:e2e:lab": "playwright test --config playwright-lab.config.js",
    "test:e2e:stage8": "playwright test --config playwright-stage8.config.js",
    "test:e2e:stage9": "playwright test --config playwright-stage9.config.js",
    "test:stage8:openobserve": "node scripts/lab/verify-stage8-openobserve.mjs",
    "test:stage9:leakage": "node scripts/lab/verify-sanitization-leakage.mjs",
    "test:stage10:correlation": "node scripts/lab/verify-stage10-correlation.mjs",
    "test:stage12:proxy-security": "node scripts/lab/verify-proxy-security.mjs",
    "test:stage14:runtime-control": "node scripts/lab/verify-stage14-runtime-control.mjs",
    "test:stage15:streams": "node scripts/lab/verify-stage15-streams.mjs",
    "test:stage16:dashboards": "node scripts/lab/verify-stage16-dashboards.mjs",
    "test:stage17:alerts": "node scripts/lab/verify-stage17-alerts.mjs",
    "test:stage18:security-acceptance": "node scripts/security/verify-stage18-security-acceptance.mjs",
    "test:coverage": "vitest run --project unit --coverage",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:local": "node scripts/security/run-local-security.js",
    "security:online": "node scripts/security/run-online-security.js",
    "sbom": "node scripts/build/generate-sbom.js",
    "verify": "node scripts/verify/run-verify.js",
    "fix": "pnpm run format && eslint . --fix",
    "lab:init": "node scripts/lab/init.mjs",
    "lab:up": "node scripts/lab/up.mjs",
    "lab:wait": "node scripts/lab/wait.mjs",
    "lab:verify": "node scripts/lab/verify.mjs",
    "lab:provision-sanitization": "node scripts/lab/provision-sanitization.mjs",
    "lab:status": "node scripts/lab/status.mjs",
    "lab:logs": "node scripts/lab/logs.mjs",
    "lab:down": "node scripts/lab/down.mjs",
    "lab:purge": "node scripts/lab/purge.mjs",
    "lab:kill-switch:on": "node scripts/lab/kill-switch.mjs on",
    "lab:kill-switch:off": "node scripts/lab/kill-switch.mjs off",
    "lab:kill-switch:status": "node scripts/lab/kill-switch.mjs status",
    "lab:streams:status": "node scripts/lab/streams-status.mjs",
    "lab:streams:dry-run": "node scripts/lab/streams-dry-run.mjs",
    "lab:streams:provision": "node scripts/lab/streams-provision.mjs",
    "lab:streams:verify": "node scripts/lab/streams-verify.mjs",
    "lab:dashboards:install-starters": "node scripts/lab/dashboards-install-starters.mjs",
    "lab:dashboards:status": "node scripts/lab/dashboards-status.mjs",
    "lab:dashboards:audit": "node scripts/lab/dashboards-audit.mjs",
    "lab:dashboards:export": "node scripts/lab/dashboards-export.mjs",
    "lab:dashboards:import": "node scripts/lab/dashboards-import.mjs",
    "lab:dashboards:backup": "node scripts/lab/dashboards-backup.mjs",
    "lab:dashboards:restore-starters": "node scripts/lab/dashboards-restore-starters.mjs",
    "lab:alerts:install-starters": "node scripts/lab/alerts-install-starters.mjs",
    "lab:alerts:status": "node scripts/lab/alerts-status.mjs",
    "lab:alerts:audit": "node scripts/lab/alerts-audit.mjs",
    "lab:alerts:export": "node scripts/lab/alerts-export.mjs",
    "lab:alerts:import": "node scripts/lab/alerts-import.mjs",
    "lab:alerts:backup": "node scripts/lab/alerts-backup.mjs",
    "lab:alerts:restore-starters": "node scripts/lab/alerts-restore-starters.mjs",
    "lab:alerts:test-notification": "node scripts/lab/alerts-test-notification.mjs"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@playwright/test": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-react": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "vitest": "catalog:",
    "yaml": "2.9.0"
  }
}
