[Unit]
Description=Frontend Observability Telemetry Ingest
After=network-online.target rabbitmq-server.service
Wants=network-online.target

[Service]
Type=simple
User=frontend-observability-telemetry-ingest
Group=frontend-observability-telemetry-ingest
WorkingDirectory=/opt/frontend-observability/current
EnvironmentFile=/etc/frontend-observability/telemetry-ingest.env
ExecStart=/usr/bin/node apps/telemetry-ingest/src/server.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/frontend-observability/telemetry-ingest
ReadOnlyPaths=/etc/frontend-observability
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
