[Unit]
Description=Chicek Observability Control Plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chicek-control-plane
Group=chicek-control-plane
WorkingDirectory=/opt/chicek-observability/current
EnvironmentFile=/etc/chicek-observability/observability-control-plane.env
ExecStart=/usr/bin/node apps/observability-control-plane/src/server.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/chicek-observability/control-plane
ReadOnlyPaths=/etc/chicek-observability
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
