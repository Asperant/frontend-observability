[Unit]
Description=Frontend Observability Control Plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=frontend-observability-control-plane
Group=frontend-observability-control-plane
WorkingDirectory=/opt/frontend-observability/current
EnvironmentFile=/etc/frontend-observability/observability-control-plane.env
ExecStart=/usr/bin/node apps/observability-control-plane/src/server.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/frontend-observability/control-plane
ReadOnlyPaths=/etc/frontend-observability
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
