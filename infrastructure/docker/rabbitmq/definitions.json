  "policies": [
    {
      "vhost": "/",
      "name": "chicek-frontend-telemetry-bounds",
      "pattern": "^chicek\\.frontend\\.",
      "apply-to": "queues",
      "definition": {
        "max-length": 25000,
        "max-length-bytes": 134217728,
        "overflow": "reject-publish",
        "delivery-limit": 16
      },
      "priority": 10
    },
    {
      "vhost": "/",
      "name": "chicek-frontend-telemetry-dlq-bounds",
      "pattern": "^chicek\\.frontend\\..*\\.dlq$",
      "apply-to": "queues",
      "definition": {
        "max-length": 5000,
        "max-length-bytes": 33554432,
        "overflow": "reject-publish"
      },
      "priority": 20
    }
  ],
  "queues": [
