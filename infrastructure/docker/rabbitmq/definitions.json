      "name": "chicek.frontend.rum.q",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-delivery-limit": 16,
        "x-dead-letter-exchange": "chicek.frontend.telemetry",
