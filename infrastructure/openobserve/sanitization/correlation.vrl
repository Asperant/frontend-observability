valid_id = r'\A[\x20-\x7e]{1,128}\z'
forbidden_control = r'[\x00-\x1f\x7f]'

if exists(.context."chicek.correlation.schema_version") {
  value = to_string(.context."chicek.correlation.schema_version") ?? ""
  if !is_string(.context."chicek.correlation.schema_version") || value != "1" {
    del(.context."chicek.correlation.schema_version")
  }
}

if exists(.context."chicek.correlation.epoch_id") {
  value = to_string(.context."chicek.correlation.epoch_id") ?? ""
  if !is_string(.context."chicek.correlation.epoch_id") || !match(value, valid_id) || match(value, forbidden_control) || contains(value, "\n") || contains(value, "\r") || contains(value, "\t") {
    del(.context."chicek.correlation.epoch_id")
  }
}

