._chicek_drop = false
valid_correlation_id = r'\A[\x20-\x7e]{1,128}\z'
forbidden_correlation_control = r'[\x00-\x1f\x7f]'
valid_test_run_id = r'\A[a-zA-Z0-9_.:-]{1,120}\z'

del(._oo.configuration.beta_encode_cookie_options)

raw = encode_json(.)
if match(raw, r'(?i)(authorization|cookie|set-cookie|bearer\s+[a-z0-9._~+/=-]{16,}|api[_-]?key\s*[=:\"]|secret\s*[=:\"]|password\s*[=:\"]|private key)') {
  ._chicek_drop = true
}

del(.usr)
del(.user)
del(.account)
del(.headers)
del(.Headers)
del(.request)
del(.response)
del(.body)
del(.payload)
del(.request_body)
del(.response_body)
del(.requestBody)
del(.responseBody)
del(.graphql)
del(.graphql_variables)
del(.graphqlVariables)
del(.chicek_correlation_schema_version)
del(.chicek_correlation_epoch_id)
del(.chicek_correlation_session_id)
del(.chicek_correlation_view_id)
del(.chicek_correlation_action_id)
del(.chicek_correlation_trusted)

if exists(.context.test_run_id) {
  test_run_value = to_string(.context.test_run_id) ?? ""
  if is_string(.context.test_run_id) && match(test_run_value, valid_test_run_id) && !match(test_run_value, forbidden_correlation_control) && !contains(test_run_value, "\n") && !contains(test_run_value, "\r") && !contains(test_run_value, "\t") {
    .test_run_id = test_run_value
  }
}
if exists(.context_test_run_id) {
  test_run_value = to_string(.context_test_run_id) ?? ""
  if is_string(.context_test_run_id) && match(test_run_value, valid_test_run_id) && !match(test_run_value, forbidden_correlation_control) && !contains(test_run_value, "\n") && !contains(test_run_value, "\r") && !contains(test_run_value, "\t") {
    .test_run_id = test_run_value
  }
  del(.context_test_run_id)
}

if exists(.context."chicek.correlation.schema_version") {
  correlation_value = to_string(.context."chicek.correlation.schema_version") ?? ""
  if is_string(.context."chicek.correlation.schema_version") && correlation_value == "1" {
    ."chicek.correlation.schema_version" = correlation_value
  }
}
if exists(.context."chicek.correlation.epoch_id") {
  correlation_value = to_string(.context."chicek.correlation.epoch_id") ?? ""
  if is_string(.context."chicek.correlation.epoch_id") && match(correlation_value, valid_correlation_id) && !match(correlation_value, forbidden_correlation_control) && !contains(correlation_value, "\n") && !contains(correlation_value, "\r") && !contains(correlation_value, "\t") {
    ."chicek.correlation.epoch_id" = correlation_value
  }
}
if exists(.context."chicek.correlation.session_id") {
  correlation_value = to_string(.context."chicek.correlation.session_id") ?? ""
  if is_string(.context."chicek.correlation.session_id") && match(correlation_value, valid_correlation_id) && !match(correlation_value, forbidden_correlation_control) && !contains(correlation_value, "\n") && !contains(correlation_value, "\r") && !contains(correlation_value, "\t") {
    ."chicek.correlation.session_id" = correlation_value
  }
}
if exists(.context."chicek.correlation.view_id") {
  correlation_value = to_string(.context."chicek.correlation.view_id") ?? ""
  if is_string(.context."chicek.correlation.view_id") && match(correlation_value, valid_correlation_id) && !match(correlation_value, forbidden_correlation_control) && !contains(correlation_value, "\n") && !contains(correlation_value, "\r") && !contains(correlation_value, "\t") {
    ."chicek.correlation.view_id" = correlation_value
  }
}
if exists(.context."chicek.correlation.action_id") {
  correlation_value = to_string(.context."chicek.correlation.action_id") ?? ""
  if is_string(.context."chicek.correlation.action_id") && match(correlation_value, valid_correlation_id) && !match(correlation_value, forbidden_correlation_control) && !contains(correlation_value, "\n") && !contains(correlation_value, "\r") && !contains(correlation_value, "\t") {
    ."chicek.correlation.action_id" = correlation_value
  }
}
if exists(.context_chicek_correlation_schema_version) {
  correlation_value = to_string(.context_chicek_correlation_schema_version) ?? ""
  if is_string(.context_chicek_correlation_schema_version) && correlation_value == "1" {
    ."chicek.correlation.schema_version" = correlation_value
  }
  del(.context_chicek_correlation_schema_version)
}
if exists(.context_chicek_correlation_epoch_id) {
  correlation_value = to_string(.context_chicek_correlation_epoch_id) ?? ""
  if is_string(.context_chicek_correlation_epoch_id) && match(correlation_value, valid_correlation_id) && !match(correlation_value, forbidden_correlation_control) && !contains(correlation_value, "\n") && !contains(correlation_value, "\r") && !contains(correlation_value, "\t") {
    ."chicek.correlation.epoch_id" = correlation_value
  }
  del(.context_chicek_correlation_epoch_id)
}
if exists(.context_chicek_correlation_session_id) {
  correlation_value = to_string(.context_chicek_correlation_session_id) ?? ""
  if is_string(.context_chicek_correlation_session_id) && match(correlation_value, valid_correlation_id) && !match(correlation_value, forbidden_correlation_control) && !contains(correlation_value, "\n") && !contains(correlation_value, "\r") && !contains(correlation_value, "\t") {
    ."chicek.correlation.session_id" = correlation_value
  }
  del(.context_chicek_correlation_session_id)
}
if exists(.context_chicek_correlation_view_id) {
  correlation_value = to_string(.context_chicek_correlation_view_id) ?? ""
  if is_string(.context_chicek_correlation_view_id) && match(correlation_value, valid_correlation_id) && !match(correlation_value, forbidden_correlation_control) && !contains(correlation_value, "\n") && !contains(correlation_value, "\r") && !contains(correlation_value, "\t") {
    ."chicek.correlation.view_id" = correlation_value
  }
  del(.context_chicek_correlation_view_id)
}
if exists(.context_chicek_correlation_action_id) {
  correlation_value = to_string(.context_chicek_correlation_action_id) ?? ""
  if is_string(.context_chicek_correlation_action_id) && match(correlation_value, valid_correlation_id) && !match(correlation_value, forbidden_correlation_control) && !contains(correlation_value, "\n") && !contains(correlation_value, "\r") && !contains(correlation_value, "\t") {
    ."chicek.correlation.action_id" = correlation_value
  }
  del(.context_chicek_correlation_action_id)
}
del(.context_chicek_correlation_trusted)

del(.context)
del(.context_password)
del(.context_secret)
del(.context_token)
del(.context_authorization)
del(.context_cookie)
del(.context_session)
del(.context_csrf)
del(.context_body)
del(.context_payload)
del(.context_request)
del(.context_response)
del(.context_header)
del(.context_card)
del(.context_cvv)
del(.context_pin)
del(.context_iban)
del(.context_email)
del(.context_phone)
del(.context_address)

if exists(.message) && is_string(.message) {
  .message = replace!(.message, r'[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}', "[REDACTED_EMAIL]")
  .message = replace!(.message, r'\+?\b(?:\d[\s().-]?){10,15}\d\b', "[REDACTED_PHONE]")
  .message = replace!(.message, r'\b[A-Z]{2}\d{2}[A-Z0-9]{11,30}\b', "[REDACTED_IBAN]")
  .message = replace!(.message, r'\b(?:\d[ -]?){13,19}\b', "[REDACTED_CARD]")
  .message = replace!(.message, r'\b[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}\b', "[REDACTED_UUID]")
  .message = replace!(.message, r'\b\d{9,}\b', "[REDACTED_ID]")
  .message = replace!(.message, r'[#?][^\s]*', "")
}

if exists(.view.url) && is_string(.view.url) {
  .view.url = replace!(.view.url, r'[#?].*$', "")
  .view.url = replace!(.view.url, r'/[0-9]{9,}([/?#]|$)', "/:id")
  .view.url = replace!(.view.url, r'/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}([/?#]|$)', "/:uuid")
  .view.url = replace!(.view.url, r'/[0-9a-fA-F]{16,}([/?#.]|$)', "/:hash")
}

if exists(.view_url) && is_string(.view_url) {
  .view_url = replace!(.view_url, r'[#?].*$', "")
  .view_url = replace!(.view_url, r'/[0-9]{9,}([/?#]|$)', "/:id")
  .view_url = replace!(.view_url, r'/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}([/?#]|$)', "/:uuid")
  .view_url = replace!(.view_url, r'/[0-9a-fA-F]{16,}([/?#.]|$)', "/:hash")
}

if exists(.http.url) && is_string(.http.url) {
  .http.url = replace!(.http.url, r'[#?].*$', "")
  .http.url = replace!(.http.url, r'/[0-9]{9,}([/?#]|$)', "/:id")
  .http.url = replace!(.http.url, r'/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}([/?#]|$)', "/:uuid")
  .http.url = replace!(.http.url, r'/[0-9a-fA-F]{16,}([/?#.]|$)', "/:hash")
}

if exists(.http_url) && is_string(.http_url) {
  .http_url = replace!(.http_url, r'[#?].*$', "")
  .http_url = replace!(.http_url, r'/[0-9]{9,}([/?#]|$)', "/:id")
  .http_url = replace!(.http_url, r'/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}([/?#]|$)', "/:uuid")
  .http_url = replace!(.http_url, r'/[0-9a-fA-F]{16,}([/?#.]|$)', "/:hash")
}

if exists(.error.message) && is_string(.error.message) {
  .error.message = replace!(.error.message, r'[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}', "[REDACTED_EMAIL]")
  .error.message = replace!(.error.message, r'\b\d{9,}\b', "[REDACTED_ID]")
}

if exists(.error.stack) && is_string(.error.stack) {
  .error.stack = replace!(.error.stack, r'[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}', "[REDACTED_EMAIL]")
  .error.stack = replace!(.error.stack, r'\b\d{9,}\b', "[REDACTED_ID]")
}

if exists(.error_message) && is_string(.error_message) {
  .error_message = replace!(.error_message, r'[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}', "[REDACTED_EMAIL]")
  .error_message = replace!(.error_message, r'\b\d{9,}\b', "[REDACTED_ID]")
}

if exists(.error_stack) && is_string(.error_stack) {
  .error_stack = replace!(.error_stack, r'[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}', "[REDACTED_EMAIL]")
  .error_stack = replace!(.error_stack, r'\b\d{9,}\b', "[REDACTED_ID]")
}
