._frontend_observability_drop = false
valid_correlation_id = r'\A[\x20-\x7e]{1,128}\z'
forbidden_correlation_control = r'[\x00-\x1f\x7f]'
valid_test_run_id = r'\A[a-zA-Z0-9_.:-]{1,120}\z'

del(._oo.configuration.beta_encode_cookie_options)

raw = encode_json(.)
if match(raw, r'(?i)(authorization|cookie|set-cookie|bearer\s+[a-z0-9._~+/=-]{16,}|api[_-]?key\s*[=:\"]|secret\s*[=:\"]|password\s*[=:\"]|private key)') {
  ._frontend_observability_drop = true
}

del(.usr)
del(.user)
del(.account)
del(.ip)
del(.client_ip)
del(.remote_addr)
del(.headers)
del(.Headers)
del(.request)
del(.response)
del(.body)
del(.payload)
del(.request_body)
del(.response_body)
del(.requestBody)
del(.responseBody)
del(.graphql)
del(.graphql_variables)
del(.graphqlVariables)
del(.frontend_observability_correlation_schema_version)
del(.frontend_observability_correlation_epoch_id)
del(.frontend_observability_correlation_session_id)
del(.frontend_observability_correlation_view_id)
del(.frontend_observability_correlation_action_id)
del(.frontend_observability_correlation_trusted)

# Session Replay is permanently disabled (docs/session-replay-security-decision.md)
# so the browser SDK never populates session.has_replay (it's only ever undefined,
# which the SDK's own JSON encoding drops) — and the vendor SDK's beforeSend hook
# refuses to let a caller set it client-side (limitModification only allows a
# fixed field allowlist that excludes session.*). Without this, _rumdata never
# gains the column at all, and OpenObserve's native RUM -> Sessions page 400s on
# every load; even once the column exists, that page's own query is
# `WHERE session_has_replay IS NOT NULL`, so every real session still needs the
# value present (false is accurate: replay never runs) to appear in the list.
# Force-set (never "only if missing"): the RUM client token is a non-secret,
# browser-exposed credential (OpenObserve integration), so a direct, non-SDK POST to the
# ingestion endpoint could otherwise forge session.has_replay:true straight
# through — has_replay must always be exactly the boolean false, regardless
# of what a caller already sent, never a caller-controlled value.
if exists(.session) && is_object(.session) {
  .session.has_replay = false
}
.session_has_replay = false

if exists(.context.test_run_id) {
  test_run_value = to_string(.context.test_run_id) ?? ""
  if is_string(.context.test_run_id) && match(test_run_value, valid_test_run_id) && !match(test_run_value, forbidden_correlation_control) && !contains(test_run_value, "\n") && !contains(test_run_value, "\r") && !contains(test_run_value, "\t") {
    .test_run_id = test_run_value
  }
}
if exists(.context_test_run_id) {
  test_run_value = to_string(.context_test_run_id) ?? ""
  if is_string(.context_test_run_id) && match(test_run_value, valid_test_run_id) && !match(test_run_value, forbidden_correlation_control) && !contains(test_run_value, "\n") && !contains(test_run_value, "\r") && !contains(test_run_value, "\t") {
    .test_run_id = test_run_value
  }
  del(.context_test_run_id)
}

if exists(.context."frontend-observability.correlation.schema_version") {
  correlation_value = to_string(.context."frontend-observability.correlation.schema_version") ?? ""
  if is_string(.context."frontend-observability.correlation.schema_version") && correlation_value == "1" {
    ."frontend-observability.correlation.schema_version" = correlation_value
  }
}
if exists(.context."frontend-observability.correlation.epoch_id") {
  correlation_value = to_string(.context."frontend-observability.correlation.epoch_id") ?? ""
  if is_string(.context."frontend-observability.correlation.epoch_id") && match(correlation_value, valid_correlation_id) && !match(correlation_value, forbidden_correlation_control) && !contains(correlation_value, "\n") && !contains(correlation_value, "\r") && !contains(correlation_value, "\t") {
    ."frontend-observability.correlation.epoch_id" = correlation_value
  }
}
if exists(.context."frontend-observability.correlation.session_id") {
  correlation_value = to_string(.context."frontend-observability.correlation.session_id") ?? ""
  if is_string(.context."frontend-observability.correlation.session_id") && match(correlation_value, valid_correlation_id) && !match(correlation_value, forbidden_correlation_control) && !contains(correlation_value, "\n") && !contains(correlation_value, "\r") && !contains(correlation_value, "\t") {
    ."frontend-observability.correlation.session_id" = correlation_value
  }
}
if exists(.context."frontend-observability.correlation.view_id") {
  correlation_value = to_string(.context."frontend-observability.correlation.view_id") ?? ""
  if is_string(.context."frontend-observability.correlation.view_id") && match(correlation_value, valid_correlation_id) && !match(correlation_value, forbidden_correlation_control) && !contains(correlation_value, "\n") && !contains(correlation_value, "\r") && !contains(correlation_value, "\t") {
    ."frontend-observability.correlation.view_id" = correlation_value
  }
}
if exists(.context."frontend-observability.correlation.action_id") {
  correlation_value = to_string(.context."frontend-observability.correlation.action_id") ?? ""
  if is_string(.context."frontend-observability.correlation.action_id") && match(correlation_value, valid_correlation_id) && !match(correlation_value, forbidden_correlation_control) && !contains(correlation_value, "\n") && !contains(correlation_value, "\r") && !contains(correlation_value, "\t") {
    ."frontend-observability.correlation.action_id" = correlation_value
  }
}
if exists(.context_frontend_observability_correlation_schema_version) {
  correlation_value = to_string(.context_frontend_observability_correlation_schema_version) ?? ""
  if is_string(.context_frontend_observability_correlation_schema_version) && correlation_value == "1" {
    ."frontend-observability.correlation.schema_version" = correlation_value
  }
  del(.context_frontend_observability_correlation_schema_version)
}
if exists(.context_frontend_observability_correlation_epoch_id) {
  correlation_value = to_string(.context_frontend_observability_correlation_epoch_id) ?? ""
  if is_string(.context_frontend_observability_correlation_epoch_id) && match(correlation_value, valid_correlation_id) && !match(correlation_value, forbidden_correlation_control) && !contains(correlation_value, "\n") && !contains(correlation_value, "\r") && !contains(correlation_value, "\t") {
    ."frontend-observability.correlation.epoch_id" = correlation_value
  }
  del(.context_frontend_observability_correlation_epoch_id)
}
if exists(.context_frontend_observability_correlation_session_id) {
  correlation_value = to_string(.context_frontend_observability_correlation_session_id) ?? ""
  if is_string(.context_frontend_observability_correlation_session_id) && match(correlation_value, valid_correlation_id) && !match(correlation_value, forbidden_correlation_control) && !contains(correlation_value, "\n") && !contains(correlation_value, "\r") && !contains(correlation_value, "\t") {
    ."frontend-observability.correlation.session_id" = correlation_value
  }
  del(.context_frontend_observability_correlation_session_id)
}
if exists(.context_frontend_observability_correlation_view_id) {
  correlation_value = to_string(.context_frontend_observability_correlation_view_id) ?? ""
  if is_string(.context_frontend_observability_correlation_view_id) && match(correlation_value, valid_correlation_id) && !match(correlation_value, forbidden_correlation_control) && !contains(correlation_value, "\n") && !contains(correlation_value, "\r") && !contains(correlation_value, "\t") {
    ."frontend-observability.correlation.view_id" = correlation_value
  }
  del(.context_frontend_observability_correlation_view_id)
}
if exists(.context_frontend_observability_correlation_action_id) {
  correlation_value = to_string(.context_frontend_observability_correlation_action_id) ?? ""
  if is_string(.context_frontend_observability_correlation_action_id) && match(correlation_value, valid_correlation_id) && !match(correlation_value, forbidden_correlation_control) && !contains(correlation_value, "\n") && !contains(correlation_value, "\r") && !contains(correlation_value, "\t") {
    ."frontend-observability.correlation.action_id" = correlation_value
  }
  del(.context_frontend_observability_correlation_action_id)
}
del(.context_frontend_observability_correlation_trusted)

del(.context)
del(.context_password)
del(.context_secret)
del(.context_token)
del(.context_authorization)
del(.context_cookie)
del(.context_session)
del(.context_csrf)
del(.context_body)
del(.context_payload)
del(.context_request)
del(.context_response)
del(.context_header)
del(.context_card)
del(.context_cvv)
del(.context_pin)
del(.context_iban)
del(.context_email)
del(.context_phone)
del(.context_address)

if exists(.view.url) && is_string(.view.url) {
  .view.url = replace!(.view.url, r'[#?].*$', "")
  .view.url = replace!(.view.url, r'/[0-9]{9,}([/?#]|$)', "/:id")
  .view.url = replace!(.view.url, r'/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}([/?#]|$)', "/:uuid")
  .view.url = replace!(.view.url, r'/[0-9a-fA-F]{16,}([/?#.]|$)', "/:hash")
}

if exists(.view_url) && is_string(.view_url) {
  .view_url = replace!(.view_url, r'[#?].*$', "")
  .view_url = replace!(.view_url, r'/[0-9]{9,}([/?#]|$)', "/:id")
  .view_url = replace!(.view_url, r'/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}([/?#]|$)', "/:uuid")
  .view_url = replace!(.view_url, r'/[0-9a-fA-F]{16,}([/?#.]|$)', "/:hash")
}

if exists(.resource.url) && is_string(.resource.url) {
  .resource.url = replace!(.resource.url, r'[#?].*$', "")
  .resource.url = replace!(.resource.url, r'/[0-9]{9,}([/?#]|$)', "/:id")
  .resource.url = replace!(.resource.url, r'/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}([/?#]|$)', "/:uuid")
  .resource.url = replace!(.resource.url, r'/[0-9a-fA-F]{16,}([/?#.]|$)', "/:hash")
  del(.resource.graphql.variables)
}

if exists(.resource_url) && is_string(.resource_url) {
  .resource_url = replace!(.resource_url, r'[#?].*$', "")
  .resource_url = replace!(.resource_url, r'/[0-9]{9,}([/?#]|$)', "/:id")
  .resource_url = replace!(.resource_url, r'/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}([/?#]|$)', "/:uuid")
  .resource_url = replace!(.resource_url, r'/[0-9a-fA-F]{16,}([/?#.]|$)', "/:hash")
}
del(.resource_graphql_variables)

if exists(.error.message) && is_string(.error.message) {
  .error.message = replace!(.error.message, r'[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}', "[REDACTED_EMAIL]")
  .error.message = replace!(.error.message, r'\+?\b(?:\d[\s().-]?){10,15}\d\b', "[REDACTED_PHONE]")
  .error.message = replace!(.error.message, r'\b[A-Z]{2}\d{2}[A-Z0-9]{11,30}\b', "[REDACTED_IBAN]")
  .error.message = replace!(.error.message, r'\b(?:\d[ -]?){13,19}\b', "[REDACTED_CARD]")
  .error.message = replace!(.error.message, r'\b[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}\b', "[REDACTED_UUID]")
  .error.message = replace!(.error.message, r'\b\d{9,}\b', "[REDACTED_ID]")
  .error.message = replace!(.error.message, r'[#?][^\s]*', "")
}

if exists(.error_message) && is_string(.error_message) {
  .error_message = replace!(.error_message, r'[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}', "[REDACTED_EMAIL]")
  .error_message = replace!(.error_message, r'\+?\b(?:\d[\s().-]?){10,15}\d\b', "[REDACTED_PHONE]")
  .error_message = replace!(.error_message, r'\b[A-Z]{2}\d{2}[A-Z0-9]{11,30}\b', "[REDACTED_IBAN]")
  .error_message = replace!(.error_message, r'\b(?:\d[ -]?){13,19}\b', "[REDACTED_CARD]")
  .error_message = replace!(.error_message, r'\b[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}\b', "[REDACTED_UUID]")
  .error_message = replace!(.error_message, r'\b\d{9,}\b', "[REDACTED_ID]")
  .error_message = replace!(.error_message, r'[#?][^\s]*', "")
}

if exists(.error.stack) && is_string(.error.stack) {
  .error.stack = replace!(.error.stack, r'[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}', "[REDACTED_EMAIL]")
  .error.stack = replace!(.error.stack, r'\b[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}\b', "[REDACTED_UUID]")
  .error.stack = replace!(.error.stack, r'\b\d{9,}\b', "[REDACTED_ID]")
  .error.stack = replace!(.error.stack, r'[#?][^\s]*', "")
