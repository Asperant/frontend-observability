if exists(.error_stack) && is_string(.error_stack) {
  .error_stack = replace!(.error_stack, r'[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}', "[REDACTED_EMAIL]")
  .error_stack = replace!(.error_stack, r'\b[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}\b', "[REDACTED_UUID]")
  .error_stack = replace!(.error_stack, r'\b\d{9,}\b', "[REDACTED_ID]")
  .error_stack = replace!(.error_stack, r'[#?][^\s]*', "")
}
