{
  "schemaVersion": 1,
  "streamName": "_rumlog",
  "derivedFrom": [
    "Real Chromium/Firefox @openobserve/browser-logs output ingested into this lab's own _rumlog stream (docs/openobserve-v0.91-stream-capabilities.md capability #5).",
    "scripts/lab/verify-openobserve-ingestion.mjs's existing regression assertions (message/status/service/env/version/application_id present on the browser-log canary).",
    "infrastructure/openobserve/sanitization/rumlog.vrl and cleanup.vrl (sanitization — forbidden-field deletions and controlled frontend-observability.* field allow-list).",
    "infrastructure/openobserve/correlation/correlation-contract.json (correlation — frontend-observability.correlation.* logical/flattened field names)."
  ],
  "requiredNativeFields": [
    "_timestamp",
    "date",
    "message",
    "status",
    "origin",
    "application_id",
    "service",
    "env",
    "version",
    "sdk_version"
  ],
  "conditionalNativeFieldGroups": {
    "context": ["session_id", "view_id", "view_url", "view_referrer", "component", "outcome"],
    "environment": [
      "ip",
      "batch_time",
      "pad",
      "ootags",
      "o2source",
      "o2_evp_origin",
      "o2_evp_origin_version",
      "o2_request_id",
      "user_agent_device_family",
      "user_agent_os_family",
      "user_agent_user_agent_family"
    ]
  },
  "controlledFields": [
    "frontend_observability_correlation_schema_version",
    "frontend_observability_correlation_epoch_id",
    "frontend_observability_correlation_session_id",
    "frontend_observability_correlation_view_id",
    "frontend_observability_correlation_action_id",
    "frontend_observability_policy_version",
    "_frontend_observability_sanitization_policy",
    "test_run_id"
  ],
  "knownFieldTypes": {
    "_frontend_observability_sanitization_policy": "Utf8",
    "_timestamp": "Int64",
    "application_id": "Utf8",
    "frontend_observability_correlation_action_id": "Utf8",
    "frontend_observability_correlation_epoch_id": "Utf8",
    "frontend_observability_correlation_schema_version": "Utf8",
    "frontend_observability_correlation_session_id": "Utf8",
    "frontend_observability_correlation_view_id": "Utf8",
    "frontend_observability_policy_version": "Utf8",
    "component": "Utf8",
    "date": "Int64",
    "env": "Utf8",
    "ip": "Utf8",
    "message": "Utf8",
    "o2_evp_origin": "Utf8",
    "o2_evp_origin_version": "Utf8",
    "o2_request_id": "Utf8",
    "o2source": "Utf8",
    "ootags": "Utf8",
    "origin": "Utf8",
    "outcome": "Utf8",
    "pad": "Utf8",
    "sdk_version": "Utf8",
    "service": "Utf8",
    "session_id": "Utf8",
    "status": "Utf8",
    "test_run_id": "Utf8",
    "user_agent_device_family": "Utf8",
    "user_agent_os_family": "Utf8",
    "user_agent_user_agent_family": "Utf8",
    "version": "Utf8",
    "view_id": "Utf8",
    "view_referrer": "Utf8",
    "view_url": "Utf8"
  },
  "forbiddenFieldNames": [
    "usr",
    "user",
    "account",
    "headers",
    "Headers",
    "request",
    "response",
    "body",
    "payload",
    "request_body",
    "response_body",
    "requestBody",
    "responseBody",
    "graphql",
    "graphql_variables",
    "graphqlVariables",
    "context",
    "context_password",
    "context_secret",
    "context_token",
    "context_authorization",
    "context_cookie",
    "context_session",
    "context_csrf",
    "context_body",
    "context_payload",
    "context_request",
    "context_response",
    "context_header",
    "context_card",
    "context_cvv",
    "context_pin",
    "context_iban",
    "context_email",
    "context_phone",
    "context_address",
    "http",
    "http_url"
  ],
  "forbiddenFieldNamePatterns": [
    "(?i)(^|_)auth(orization)?($|_)",
    "(?i)(^|_)cookie($|_)",
    "(?i)(^|_)(token|bearer)($|_)",
    "(?i)(^|_)secret($|_)",
    "(?i)(^|_)private[_-]?key($|_)",
    "(?i)(^|_)password($|_)",
    "(?i)(^|_)(req|request|res|response)_body($|_)",
    "(?i)(^|_)(email|user_email)($|_)"
  ],
  "forbiddenValuePatterns": [
    "(?i)(authorization|cookie|set-cookie|bearer\\s+[a-z0-9._~+/=-]{16,}|api[_-]?key\\s*[=:\"]|secret\\s*[=:\"]|password\\s*[=:\"]|private key)"
  ],
  "urlFieldsMustNotContainQueryOrFragment": ["view_url"],
  "notes": [
    "requiredNativeFields is intentionally short: only fields observed present on every browser-log record in this repo's own OpenObserve integration regression. 'component'/'outcome'/'view_*' are conditional because they are only populated on some log entries.",
    "This contract intentionally does NOT freeze the native schema as a strict allow-list: new optional native fields from a future @openobserve/browser-logs version are expected and are SAFE_ADDITIVE_NATIVE_DRIFT, not a failure, as long as they are not in forbiddenFieldNames/forbiddenFieldNamePatterns and do not change an existing required field's type.",
    "'http'/'http_url' are listed as forbidden field NAMES here because rumlog.vrl only ever normalizes them in place (strips query/fragment) rather than deleting them outright, but this repo's actual browser-logs usage (tests/fixtures/apps/browser-app) never sets a raw HTTP context object on a log — if one ever appears un-normalized it indicates a bypass of the sanitization pipeline and must be treated as SECURITY_DRIFT, not silently allowed through as a new conditional field."
  ]
}
