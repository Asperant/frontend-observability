{
  "schemaVersion": "1.0.0",
  "policyVersion": "telemetry-sanitization-v1",
  "forbiddenSchemes": ["data:", "blob:", "javascript:", "file:"],
  "maxUrlBytes": 1024,
  "maxStringLength": 128,
  "maxActionNameLength": 80,
  "maxActionNameSegments": 6,
  "maxAttributeCount": 12,
  "maxAttributeKeyLength": 48,
  "maxAttributeBytes": 2048,
  "maxErrorMessageLength": 512,
  "maxStackBytes": 8192,
  "maxStackFrames": 20,
  "maxErrorCauseDepth": 3,
  "maxErrorContextBytes": 4096,
  "sensitiveRoutes": [
    "/login",
    "/auth",
    "/password",
    "/reset-password",
    "/payment",
    "/checkout",
    "/card",
    "/identity",
    "/kyc",
    "/document",
    "/upload"
  ],
  "observabilityResourcePaths": [
    "/rum/v1/default/rum",
    "/rum/v1/default/logs",
    "/observability/config.json"
  ],
  "forbiddenKeyCategories": [
    "password",
    "secret",
    "token",
    "authorization",
    "cookie",
    "session",
    "csrf",
    "body",
    "payload",
    "request",
    "response",
    "header",
    "card",
    "cvv",
    "pin",
    "iban",
    "email",
    "phone",
    "address"
  ],
  "placeholders": {
    "email": "[REDACTED_EMAIL]",
    "phone": "[REDACTED_PHONE]",
    "iban": "[REDACTED_IBAN]",
    "card": "[REDACTED_CARD]",
    "uuid": "[REDACTED_UUID]",
    "identifier": "[REDACTED_ID]",
    "token": "[REDACTED_TOKEN]",
    "urlSensitive": "__sensitive__"
  }
}
