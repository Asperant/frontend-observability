{
  "schemaVersion": "1.0.0",
  "description": "Synthetic telemetry sanitization corpus. Contains no real personal data and no country/company-specific identifier rules.",
  "canaries": {
    "email": "alice.test@example.invalid",
    "phone": "+1 415 555 0134",
    "iban": "GB82WEST12345698765432",
    "card": "4111 1111 1111 1111",
    "bearer": "Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJzYWZlLXRlc3QifQ.signature",
    "apiKey": "api_key=sk_test_abcdefghijklmnopqrstuvwxyz123456",
    "uuid": "123e4567-e89b-12d3-a456-426614174000",
    "longNumericIdentifier": "12345678901234567890",
    "queryFragmentUrl": "https://example.invalid/account/12345678901234567890?email=alice.test@example.invalid#token",
    "privateKeyMarker": "SYNTHETIC_PRIVATE_KEY_MARKER",
    "oversizedStringMarker": "OVERSIZED_SYNTHETIC_STRING"
  },
  "cases": [
    {
      "name": "safe_action",
      "input": { "name": "demo.safe-action", "attributes": { "source": "button", "ok": true } },
      "expect": "accept"
    },
    {
      "name": "pii_string",
      "input": "Contact alice.test@example.invalid at +1 415 555 0134",
      "expect": "redact"
    },
    {
      "name": "secret_string",
      "input": "Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJzYWZlLXRlc3QifQ.signature",
      "expect": "drop"
    },
    {
      "name": "url_query_fragment",
      "input": "https://example.invalid/users/12345678901234567890?email=alice.test@example.invalid#token",
      "expect": "redact"
    },
    {
      "name": "private_key",
      "input": "SYNTHETIC_PRIVATE_KEY_MARKER",
      "expect": "drop"
    }
  ]
}
